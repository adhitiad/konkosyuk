{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "proto:gen": {
      "outputs": ["src/gen/**"]
    },
    "build": {
      "dependsOn": ["^build", "^proto:gen"],
      "outputs": ["dist/**", ".next/**", "build/**", "public/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
