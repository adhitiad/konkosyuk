{
  "name": "@konkosyuk/grpc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "start": "bun run dist/server.js",
    "proto:gen": "bun run scripts/gen-proto.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.8.1",
    "@konkosyuk/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9",
    "globals": "^17.11.0",
    "ts-proto": "^1.170.0",
    "typescript": "^6"
  }
