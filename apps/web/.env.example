# =============================================================================
# Konkosyuk - Booking System Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DEVELOPMENT ENVIRONMENT
# -----------------------------------------------------------------------------
# Gunakan nilai ini untuk development lokal

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/konkosyuk

# Redis (Upstash - format ioredis)
# Redis URL untuk ioredis (koneksi binary, BUKAN REST)
# Format: rediss://default:<token>@<endpoint>.upstash.io:<port>
# Contoh: rediss://default:AxJz...@us1-abc.upstash.io:6379
# Catatan: JANGAN gunakan format UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN
REDIS_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32 (min 32 chars)
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring & Error Tracking (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Maps - Stadia Maps (Gratis, privacy-first)
NEXT_PUBLIC_STADIA_MAPS_API_KEY=

# Real-time Chat & Notifications - Ably
# Bisa juga diatur via /admin/settings (app_settings table)
# Digunakan untuk chat real-time dan notifikasi in-app
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_KEY=

# KYC Verification - Didit
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
NEXT_PUBLIC_DIDIT_API_URL=https://verification.didit.me

# Google OAuth (Opsional - untuk development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Gateway - Doku (Opsional - untuk development)
DOKU_BASE_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_WEBHOOK_SECRET=

# Payment Gateway - iPaymu (Opsional - untuk development)
IPAYMU_BASE_URL=https://api.ipaymu.com
IPAYMU_API_KEY=
IPAYMU_WEBHOOK_SECRET=

# Payment Gateway - Nicepay (Opsional - untuk development)
NICEPAY_BASE_URL=https://api.nicepay.co.id
NICEPAY_MERCHANT_ID=
NICEPAY_MERCHANT_KEY=
NICEPAY_WEBHOOK_SECRET=

# Payment Gateway - Otto Digital (Opsional - untuk development)
OTTO_BASE_URL=https://sandbox.ottodigital.id
OTTO_CLIENT_ID=
OTTO_SECRET_KEY=
OTTO_WEBHOOK_SECRET=

# Payment Mode
PAYMENT_MODE=mock
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Notification Settings Encryption
# Generate: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=

# Storage
UPLOADTHING_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PRIMARY=uploadthing

# Web Push Notification (VAPID)
VAPID_SUBJECT=mailto:admin@konkosyuk.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Notifications - Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=KonkosYuk <noreply@domain-anda.com>

# Notifications - Telegram
TELEGRAM_BOT_TOKEN=

# Notifications - WhatsApp (Fonnte)
FONNTE_TOKEN=

# Background Jobs - Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Untuk development lokal dengan ngrok, sesuaikan dengan URL ngrok Anda
# QSTASH_WORKER_URL=https://<ngrok-url>/api/qstash/worker
QSTASH_WORKER_URL=https://<your-domain>/api/qstash/worker

# Cost Monitoring - Threshold Usage Bulanan
# Batas volume operasi per bulan sebelum alert dikirim
COST_THRESHOLD_QSTASH=100000
COST_THRESHOLD_ABLY=500000
COST_THRESHOLD_REDIS=100000

# Admin Telegram Chat ID untuk alert biaya
# Format: numeric chat ID (contoh: 123456789)
ADMIN_TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT
# -----------------------------------------------------------------------------
# Gunakan nilai ini untuk production deployment
# Simpan di platform deployment (Netlify/Vercel) sebagai environment variables

# Database
# DATABASE_URL=postgresql://user:password@host:5432/konkosyuk_prod

# Redis (Upstash)
# REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:<port>

# Better Auth
# BETTER_AUTH_URL=https://konkosyuk.com
# BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
# NEXT_PUBLIC_APP_URL=https://konkosyuk.com

# Payment Gateway - Doku
# DOKU_BASE_URL=https://api.doku.com
# DOKU_CLIENT_ID=your_client_id
# DOKU_SECRET_KEY=your_secret_key
# DOKU_WEBHOOK_SECRET=your_webhook_secret

# Payment Gateway - iPaymu
# IPAYMU_BASE_URL=https://api.ipaymu.com
# IPAYMU_API_KEY=your_api_key
# IPAYMU_WEBHOOK_SECRET=your_webhook_secret

# Payment Gateway - Nicepay
# NICEPAY_BASE_URL=https://api.nicepay.co.id
# NICEPAY_MERCHANT_ID=your_merchant_id
# NICEPAY_MERCHANT_KEY=your_merchant_key
# NICEPAY_WEBHOOK_SECRET=your_webhook_secret

# Payment Gateway - Otto Digital
# OTTO_BASE_URL=https://api.ottodigital.id
# OTTO_CLIENT_ID=your_client_id
# OTTO_SECRET_KEY=your_secret_key
# OTTO_WEBHOOK_SECRET=your_webhook_secret

# Payment Mode
# PAYMENT_MODE=live
# PAYMENT_CONFIG_ENCRYPTION_KEY=generate_with_node_e_console

# Storage
# UPLOADTHING_TOKEN=your_uploadthing_token
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Web Push Notification (VAPID)
# VAPID_SUBJECT=mailto:admin@konkosyuk.app
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# Maps - Stadia Maps
# NEXT_PUBLIC_STADIA_MAPS_API_KEY=your_stadia_maps_api_key

# KYC Verification - Didit
# DIDIT_API_KEY=your_didit_api_key
# DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret
# NEXT_PUBLIC_DIDIT_API_URL=https://api.didit.me

# Notifications - Resend Email
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=KonkosYuk <noreply@konkosyuk.app>

# Notifications - Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Notifications - WhatsApp (Fonnte)
# FONNTE_TOKEN=your_fonnte_token
# Rate limit global untuk Fonnte (dibagi semua instance Next.js via Redis)
# Default aman: 5 pesan/detik (limit resmi Fonnte ~10 msg/sec, safety margin 50%)
# Untuk akun tier tinggi, bisa dinaikkan, contoh: FONNTE_RATE_LIMIT=20
# FONNTE_RATE_LIMIT=5
# FONNTE_RATE_WINDOW=1
