# =============================================================================
# Konkosyuk - Booking System Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/booking_kost

# Database utama tetap PostgreSQL/Supabase. Redis hanya cache, rate limit, dan state sementara.
# Prioritas koneksi: Upstash -> Redis Cloud -> Redis lokal -> memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CLOUD_URL=redis://default:password@host:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_URL1=http://localhost:3000
BETTER_AUTH_URL2=http://localhost:3000
BETTER_AUTH_SECRET=isi_sendiri_minimal_32_karakter_random
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL1=http://localhost:3000
NEXT_PUBLIC_APP_URL2=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (Opsional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Payment Gateway - Sakuku
# -----------------------------------------------------------------------------
SAKUKU_BASE_URL=
SAKUKU_CLIENT_ID=
SAKUKU_SECRET_KEY=
SAKUKU_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payment Gateway - Doku
# -----------------------------------------------------------------------------
DOKU_BASE_URL=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payment Gateway - iPaymu
# -----------------------------------------------------------------------------
IPAYMU_BASE_URL=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payment Gateway - Nicepay
# -----------------------------------------------------------------------------
NICEPAY_BASE_URL=
NICEPAY_MERCHANT_ID=
NICEPAY_MERCHANT_KEY=
NICEPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payment Mode
# -----------------------------------------------------------------------------
PAYMENT_MODE=mock
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_CONFIG_ENCRYPTION_KEY=
# PAYMENT_MODE=live requires a complete gateway configuration and webhook secret.

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
UPLOADTHING_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PRIMARY=uploadthing

# -----------------------------------------------------------------------------
# Cron Job
# -----------------------------------------------------------------------------
CRON_SECRET=isi_dengan_string_random_minimal_32_karakter

# -----------------------------------------------------------------------------
# Web Push Notification (VAPID)
# -----------------------------------------------------------------------------
VAPID_SUBJECT=mailto:admin@konkosyuk.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Notifications - Resend Email
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=KonkosYuk <noreply@domain-anda.com>

# -----------------------------------------------------------------------------
# Notifications - Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_MAINTENANCE_CREATED_TEMPLATE=maintenance_report_created
META_MAINTENANCE_UPDATED_TEMPLATE=maintenance_report_updated
